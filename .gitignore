# --- Secrets & local config (NEVER commit) ---
.env
.env.*
!.env.example
.sinas/
sinas-config.local.yaml
*.session
*.session-journal
telegram*.session*
*session_string*
secrets.json
credentials.json

# --- Telegram / private data & downloaded media (NEVER commit) ---
data/
media/
downloads/
corpus/
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.ts
# allow tiny tracked test assets explicitly if ever needed:
!tests/fixtures/**/*.json
# Demo sample videos are tracked on purpose (they ARE the demo inputs).
# This overrides the media patterns above for the samples/ folder only.
!samples/
!samples/**

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node (for @sinas/cli) ---
node_modules/
npm-debug.log*

# --- Official Sinas skills (AGPL-3.0; license-compatible with this AGPL repo) ---
# Kept out of git so they stay fresh from upstream; installed/refreshed by
# scripts/setup_sinas_skills.sh for Claude Code to auto-discover.
.claude/skills/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp

# local pipeline harness scratch (scripts/try_local_pipeline.py)
.localinstance/
