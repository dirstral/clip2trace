# clip2trace — example environment file.
# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).

# --- Sinas instance ---
# Defaults to via-10 (this project's instance); change the host for a different one.
SINAS_BASE_URL=https://via-10.sinas.wearebrain.com
SINAS_CONSOLE_URL=https://via-10.sinas.wearebrain.com:51245

# API key for the Management API (/api/v1/...), function execute, and @sinas/cli.
# IMPORTANT: mint it with WILDCARD permissions (sinas.<resource>.*:all), NOT
# explicit-action perms like sinas.functions.execute:all — explicit-action keys
# pass /auth/check-permissions but 403 at the resource gate (#44). Least-privilege
# working set + the POST /api/v1/api-keys recipe are in
# docs/research/permissions-diagnosis.md. Do NOT commit the real value.
SINAS_ADMIN_TOKEN=

# Default Claude model expected by clip2trace agents.
SINAS_DEFAULT_MODEL=claude-sonnet-4-6

# --- Telegram (LIVE search only; otherwise leave blank and run in demo mode) ---
# In production these live as Sinas SECRETS (full names: TELEGRAM_API_ID,
# TELEGRAM_API_HASH, TELEGRAM_SESSION_STRING). Since the package is installed, set
# them WITHOUT a re-install via the secrets API, e.g.:
#   curl -X POST "$SINAS_BASE_URL/api/v1/secrets" -H "Authorization: Bearer $SINAS_ADMIN_TOKEN" \
#        -H 'Content-Type: application/json' -d '{"name":"TELEGRAM_API_ID","value":"..."}'
# This .env file is only for the local bootstrap (scripts/bootstrap_telegram_session.py).
# A USER account (not a bot) is required for channels.searchPosts. See docs/telegram-global-search.md.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generated once by scripts/bootstrap_telegram_session.py. Treat as full account access.
TELEGRAM_SESSION_STRING=

# --- clip2trace runtime toggles ---
ENABLE_TELEGRAM_LIVE_SEARCH=false
MAX_VIDEO_MB=500
CLIP2TRACE_MODE=demo
