# clip2trace — example environment file.
# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).

# --- Sinas instance ---
# Replace X with your team's instance number (from your VIA signup).
SINAS_BASE_URL=https://via-X.sinas.wearebrain.com
SINAS_CONSOLE_URL=https://via-X.sinas.wearebrain.com:51245

# Admin API token for the Management API (/api/v1/...) and the @sinas/cli.
# Create it from the management console. Used by `sinas login`. Do NOT commit.
SINAS_ADMIN_TOKEN=

# Default Claude model expected by clip2trace agents.
SINAS_DEFAULT_MODEL=claude-sonnet-4-6

# --- Telegram (LIVE search only; otherwise leave blank and run in demo mode) ---
# These are stored as Sinas SECRETS at install time, not read from .env in production.
# This file is only for local bootstrap scripts (scripts/bootstrap_telegram_session.py).
# A USER account (not a bot) is required for channels.searchPosts. See docs/telegram-global-search.md.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generated once by scripts/bootstrap_telegram_session.py. Treat as full account access.
TELEGRAM_SESSION_STRING=

# --- clip2trace runtime toggles ---
ENABLE_TELEGRAM_LIVE_SEARCH=false
MAX_VIDEO_MB=500
CLIP2TRACE_MODE=demo
